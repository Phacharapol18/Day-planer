<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="14dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/r_time"
        android:layout_width="58dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:textColor="@color/widget_muted"
        android:textSize="12.5sp" />

    <ImageView
        android:id="@+id/r_rail"
        android:layout_width="3dp"
        android:layout_height="22dp"
        android:layout_marginEnd="10dp"
        android:background="@color/cat_work"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/r_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/widget_ink"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/r_cal"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_calendar_small"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/r_live"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_live_dot"
        android:visibility="gone" />
</LinearLayout>
