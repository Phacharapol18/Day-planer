<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+: cloud backup and device-to-device transfer carry the plan to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="app_webview/Default/Cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
