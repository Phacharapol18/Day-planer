<?xml version="1.0" encoding="utf-8"?>
<!-- Splash icon: dark rounded tile with the timeline mark, centered in the 108dp splash canvas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="72dp" android:height="72dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_fg" />
</layer-list>
